#include <stdio.h>
#include <stdlib.h>

#define RED     "\033[0;31m" 
#define GREEN   "\033[0;32m" 
#define YELLOW  "\033[0;33m" 
#define MAGENTA  "\033[0;35m" 
#define CYAN      "\033[0;36m" 
#define RESET   "\033[0m"  
#define BLUE    "\x1b[34m"  

void depositMoney(int *balance, int deposit) {
    if (deposit <= 0) {
        printf(RED "Invalid deposit amount! \n" RESET);
        return;
    }
    *balance += deposit;
}
void withdrawMoney(int *balance, int withdraw) {
    if (withdraw <= 0) {
        printf(RED "Invalid withdrawal amount! \n" RESET);
        return;
    }
    *balance -= withdraw;
}


int main  () { 

        printf(MAGENTA "================= ATM SIMULATOR ================= \n" RESET); 
        printf(" \n");
        printf(CYAN "Welcome! Please select an option. \n"RESET); 
        printf(" \n");  
        printf("1. Check Balance \n"); 
        printf("2. Deposit Money OR Withdraw Money \n");  
        printf("3. Exit \n"); 
        printf("---> ");    

    int n, pin, count_pinEntry = 4,  balance = 5000; 
    int m, deposit, withdraw;

        scanf("%d", &n); 

// ATM Check Balance  
 

    if (n==1) { 

        printf(MAGENTA "==================Check Balance=================== \n" RESET); 
        printf(" \n");

        printf(BLUE "Enter your ATM pin: " RESET); 
        scanf("%d", &pin);  

        do { 
            count_pinEntry--;   
        
            if (pin == 595456) {
                printf(MAGENTA"Your current balance is: $%d \n"RESET, balance);
                break;
            } 

            else if (pin != 595456 && pin != 0) {  
                if (count_pinEntry >= 1) {
                printf(RED "WRONG PIN--->    " RESET); 
                printf(YELLOW "%d Attempts left \n" RESET, count_pinEntry);  
                printf(" \n");
                printf(BLUE "Enter your ATM pin: " RESET);
                scanf("%d", &pin); 
                }
            }  

             else if (count_pinEntry < 1) { 
                printf(" \n");
                printf(MAGENTA "Thank for using our ATM simulator! \n" RESET); 
                break;
            }


        } while (1);

        } 
            

// ATM Money Deposit / Money Withdraw 

    if (n==2) {  
                printf(BLUE "==================Change Balance================== \n" RESET); 

                printf(CYAN "Select-->\n"RESET);
                printf("1. Deposit Money \n");
                printf("2. Withdraw Money \n");   
                printf("---> ");
                scanf("%d", &m);  

                
        if (m==1) {

                printf("Enter the amount to be deposited(In Dollars): "); 
                scanf("%d", &deposit); 
                printf(" \n");
                printf(BLUE "Enter your ATM pin: " RESET); 
                scanf("%d", &pin); 
                
            if (pin == 595456) {
                depositMoney(&balance, deposit);
                printf(MAGENTA"Your new current balance is: $%d \n"RESET, balance);
            } 

            else if (pin != 595456) {
                printf(RED "WRONG PIN" RESET); 
                printf(MAGENTA "Thank for using our ATM simulator! \n" RESET);
            }
                }

        else if (m == 2) {
                printf("Enter the amount to be withdrawn(In Dollars): "); 
                scanf("%d", &withdraw);
                printf(" \n");
                printf(BLUE "Enter your ATM pin: " RESET); 
                scanf("%d", &pin);

                if (pin == 595456) {
                
                if (withdraw > balance) {
                    printf(RED "Insufficient balance! \n" RESET);
                }
                else {
                    withdrawMoney(&balance, withdraw);
                printf(MAGENTA"Your new current balance is: $%d \n"RESET, balance);
            }
            
            } 

            else if (pin != 595456) {
                printf(RED "WRONG PIN" RESET); 
                printf(MAGENTA "Thank for using our ATM simulator! \n" RESET);
            }

        }

        else if (m>=3 || m<=0) {
                printf(" \n");
                printf(MAGENTA "Thank for using our ATM simulator! \n" RESET); 
              }

        else if (pin != 595456) {
                printf(RED "WRONG PIN \n" RESET);
                printf(" \n");
                printf(MAGENTA "Thank for using our ATM simulator! \n" RESET); 
              }
            
                 
                
         if (m>=3 || m<=0) {
            printf(RED "Invalid option! \n" RESET);
            printf(" \n");
            printf(MAGENTA "Thank for using our ATM simulator! \n" RESET);
            } 
        }
// EXIT 
         if (m>=3 || m<=0) {
            printf(RED "Invalid option! \n" RESET);
            printf(" \n");
            printf(MAGENTA "Thank for using our ATM simulator! \n" RESET); 
            } 

    
return 0;
}
